#!/bin/bash
        set -eux

        echo "Bienvenido/a al planeta $OPTION"

        if [ "$FLAG" = "true" ]; then
            echo "Prepárate para la misión, agente $NOMBRE; que la fuerza te acompañe."
        else
            echo "Disfruta el planeta humano/a $NOMBRE. Trata de no morir."
        fi

        echo "..."
        sleep 10
        echo "¡Suerte! La necesitarás."
